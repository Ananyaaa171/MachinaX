# Root .gitignore for MACHINA-X monorepo

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment files with secrets
.env.local
.env.*.local

# ========================
# Java / Maven
# ========================
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# IDE files
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ========================
# Node / React / Vite
# ========================
node_modules/
dist/
.vite/
*.local

# ========================
# OS
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# ML models (large binaries)
# ========================
*.pkl
*.joblib
*.pt
*.pth
ml-service/models/*.pkl
ml-service/models/*.joblib
ml-service/models/*.pt

# ========================
# Logs
# ========================
*.log
logs/

# ========================
# IDE
# ========================
.vscode/settings.json
